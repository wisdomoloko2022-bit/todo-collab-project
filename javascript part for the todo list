<script>
// Wait until the page has fully loaded
document.addEventListener("DOMContentLoaded", function() {

  // Get elements from the page
  const taskInput = document.getElementById("taskInput"); // The input box
  const addBtn = document.getElementById("addBtn");       // The "Add" button
  const taskList = document.getElementById("taskList");   // The list (ul) where tasks will appear

  // Enable input and button when page loads
  taskInput.disabled = false;
  addBtn.disabled = false;
  addBtn.style.cursor = "pointer";

  // When user clicks the "Add" button, run the addTask function
  addBtn.addEventListener("click", addTask);

  // Also allow pressing the Enter key to add a task
  taskInput.addEventListener("keypress", function(event) {
    if (event.key === "Enter") {
      addTask(); // Call addTask when Enter is pressed
    }
  });

  // Function that adds a new task
  function addTask() {
    // Get the text inside the input box and remove extra spaces
    const taskText = taskInput.value.trim();

    // If the input is empty, show an alert and stop
    if (taskText === "") {
      alert("Please write a task before adding.");
      return;
    }

    // Create a new <li> element
    const li = document.createElement("li");

    // Set the text of the <li> to what the user typed
    li.textContent = taskText;

    // Add a click event to toggle (mark/unmark) completion
    li.addEventListener("click", function() {
      li.classList.toggle("completed"); // Add or remove the class "completed"
      // Apply line-through when completed
      if (li.classList.contains("completed")) {
        li.style.textDecoration = "line-through";
        li.style.color = "gray";
      } else {
        li.style.textDecoration = "none";
        li.style.color = "#333";
      }
    });

    // Create a delete button (✖) beside the task
    const deleteBtn = document.createElement("button");
    deleteBtn.textContent = "✖"; // Cross symbol
    deleteBtn.style.background = "transparent";
    deleteBtn.style.border = "none";
    deleteBtn.style.color = "red";
    deleteBtn.style.cursor = "pointer";
    deleteBtn.style.marginLeft = "auto";
    deleteBtn.style.fontSize = "16px";

    // When delete button is clicked, remove the task from the list
    deleteBtn.addEventListener("click", function(event) {
      event.stopPropagation(); // Stop it from also triggering the mark complete action
      li.remove(); // Remove the task
    });

    // Add the delete button inside the <li>
    li.appendChild(deleteBtn);

    // Add the <li> into the <ul> (task list)
    taskList.appendChild(li);

    // Clear the input box for the next task
    taskInput.value = "";
  }

});
</script>
